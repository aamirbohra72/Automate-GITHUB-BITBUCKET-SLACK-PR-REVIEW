{
  "name": "pr-slack-notifier",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "send-test-webhook": "tsx scripts/send-test-webhook.ts",
    "lint": "eslint src test drizzle.config.ts",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.1",
    "@slack/web-api": "7.9.3",
    "dotenv": "16.6.1",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "pg": "8.16.3",
    "pino": "9.9.0",
    "yaml": "2.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.35.0",
    "globals": "16.4.0",
    "nock": "14.0.10",
    "prettier": "3.6.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.25.12"
  }
}
