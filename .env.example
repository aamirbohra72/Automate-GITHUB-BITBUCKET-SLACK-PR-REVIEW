# Slack bot token (chat:write scope) and fallback channel ID
SLACK_BOT_TOKEN=xoxb-replace-me
SLACK_DEFAULT_CHANNEL_ID=C0123456789

# Set long random secrets in both provider webhook configurations
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-secret
BITBUCKET_WEBHOOK_SECRET=replace-with-a-long-random-secret

# Neon pooled URL for the app; direct URL is only used by drizzle-kit migrations
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL_DIRECT=postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require

CONFIG_PATH=./config.yaml
LOG_LEVEL=info
PORT=3000
NODE_ENV=production
